# Default deny: imported working trees remain on disk, outside Git.
/*
!/.gitignore
!/BASELINE-REVIEW.md
!/UPGRADE-DECISIONS.md
!/MAPPING-CONSISTENCY-PLAN.md
!/BASELINE-PRESERVATION.md
!/preservation/
!/mapping-dev/
!/.github/

# Apply even inside explicitly preserved source sets.
**/node_modules/
**/.env
**/.env.*
**/maps.local.json
**/*fixtures*.json
**/fixture.json
**/*credentials*
**/*secret*
**/wp-config.php
**/config.log.php
**/db.php
**/db.v7.4.php
**/db-07072024.php
**/Connections/
**/datafiles/
**/uploads/
**/cache/
**/logs/
**/error_log
**/*.log
**/*.sql
**/*.sql.*
**/*.dump
**/*.zip
**/*.tar
**/*.gz
**/*.kmz
**/*.kml
**/*.csv
**/*.png
**/*.jpg
**/*.jpeg
**/*.gif
**/*.webp
**/*results.json
**/*verification.json
**/playwright-report/
**/test-results/
**/.DS_Store
**/Thumbs.db
